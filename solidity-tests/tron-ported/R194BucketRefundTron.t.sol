pragma solidity ^0.8.24;

import {SignerMintedToken} from "../../contracts/bridged/SignerMintedToken.sol";
import {R194BaseTron, r194id} from "./R194BaseTron.sol";

/// Agent 194: evidence for leaving agent 171's F171-2 (a cancel refunds the bucket above the token-bucket bound) out of
/// the rebuild. Both tests pass on the current code; the second computes what 171's proposed fix would leave.
contract R194BucketRefundTestTron is R194BaseTron {
    /// 171's burst reproduces at T = 0 (the forger refills the bucket by having its own junk cancelled and queues again
    /// at once), but at T = 0 every admitted forged mint is queued and cancellable, so the extra admission credits
    /// nothing forged while the guardians cancel; and if they did not, one forged unit already holds every later exit,
    /// whatever the bucket allowed. The bucket is not the bound that stops a forgery.
    function test_F171_2_atT0TheBurstCreditsNothingForged() public {
        bytes32 junk = r194id(keccak256("junk"), 0);
        mint(junk, 0, BUCKET, MALLORY); // the whole bucket
        vm.warp(block.timestamp + 11 hours);
        cancel(junk); // slot 0 contested; refund of 10,000 on top of 11 h of refill, capped at the bucket
        require(token.availableToMint() == BUCKET, "bucket full again after 11 h + refund");
        bytes32 junk2 = r194id(keccak256("junk2"), 0);
        mint(junk2, 0, BUCKET, MALLORY); // a second full bucket within 11 h of the first: 171's burst
        cancel(junk2);
        bytes32 real = deposit(uint64(100 * U), ALICE);
        mint(real, 0, uint64(100 * U), ALICE);
        vm.warp(block.timestamp + 12 hours);
        token.executeMint(real);
        require(token.mintCount() == 1 && token.balanceOf(MALLORY) == 0 && token.balanceOf(ALICE) == 100 * U,
            "nothing forged credited; the real deposit did");
        require(token.mintHead() == vault.chainHeadAt(1), "chains agree");
    }

    /// 171's suggested fix, "refund only what has not refilled since the charge", under-refunds whenever the bucket was not
    /// full: honest users spend 5,000, the forger queues the other 5,000, the guardians cancel it just before its 12 h. The
    /// current refund restores exactly the level the bucket would have without the forgery (full); the suggested fix
    /// would leave it at about half, so every cancelled forgery batch would cost honest users up to half a day of capacity.
    function test_F171_2_theSuggestedFixWouldCostHonestCapacity() public {
        bytes32 h = deposit(uint64(5_000 * U), ALICE);
        mint(h, 0, uint64(5_000 * U), ALICE);
        bytes32 junk = r194id(keccak256("junk"), 1);
        mint(junk, 1, uint64(5_000 * U), MALLORY);
        require(token.availableToMint() == 0, "bucket empty");
        uint256 waited = 12 hours - 60;
        vm.warp(block.timestamp + waited);
        uint256 before = token.availableToMint();
        cancel(junk);
        uint256 current = token.availableToMint();
        uint256 a = 5_000 * U;
        uint256 refilled = waited * token.refillPerSecond();
        uint256 suggested = before + (a > refilled ? a - refilled : 0);
        if (suggested > BUCKET) suggested = BUCKET;
        uint256 withoutForgery = 5_000 * U + refilled > BUCKET ? BUCKET : 5_000 * U + refilled;
        require(current == withoutForgery, "current refund = the level without the forgery");
        require(suggested + 4_900 * U < current, "the suggested fix would leave honest users about 5,000 short");
    }
}
