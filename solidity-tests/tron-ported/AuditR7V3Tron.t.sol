/// An honest light-client mint verifier for the token: it accepts a mint only for a deposit that is real on Ethereum.
/// `commit` is the test's way of saying "a valid proof of this real, final deposit exists".
contract A111HonestMintVerifierTron {
    mapping(bytes32 => bool) public committed;

    function commit(bytes32 mintHash) external {
        committed[mintHash] = true;
    }

    function verifyMint(address, bytes32 mintHash, bytes calldata) external view returns (bytes4) {
        return committed[mintHash] ? this.verifyMint.selector : bytes4(0);
    }
}

/// An honest light-client release verifier for the vault: a proof exists for every real, final L2 burn log.
contract A111HonestReleaseVerifierTron {
    mapping(bytes32 => bool) public committed;

    function commit(bytes32 id) external {
        committed[id] = true;
    }

    function verifyRelease(address, bytes32 id, bytes calldata) external view returns (bytes4) {
        return committed[id] ? this.verifyRelease.selector : bytes4(0);
    }
}

