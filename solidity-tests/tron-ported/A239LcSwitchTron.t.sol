    // ---------------------------------------------------------------- helpers

    function sortedKeys(uint256 base) private pure returns (uint256[] memory k) {
        k = new uint256[](7);
        for (uint256 i; i < 7; ++i) k[i] = base + i;
        for (uint256 i; i < 7; ++i) {
            for (uint256 j = i + 1; j < 7; ++j) {
                if (vm.addr(k[j]) < vm.addr(k[i])) (k[i], k[j]) = (k[j], k[i]);
            }
        }
    }

    function addrs(uint256[] memory k) private pure returns (address[] memory a) {
        a = new address[](k.length);
        for (uint256 i; i < k.length; ++i) a[i] = vm.addr(k[i]);
    }

    function cert(bytes32 h, uint256 n) private view returns (bytes[] memory out) {
        out = new bytes[](n);
        for (uint256 i; i < n; ++i) {
            (uint8 v, bytes32 r, bytes32 s) = vm.sign(ethKeys[i], h);
            out[i] = abi.encodePacked(r, s, v);
        }
    }

    function mintBlob(bytes32 h, uint256 n) private view returns (bytes memory out) {
        for (uint256 i; i < n; ++i) {
            (uint8 v, bytes32 r, bytes32 s) = vm.sign(mintKeys[i], h);
            out = bytes.concat(out, abi.encodePacked(r, s, v));
        }
    }

    function cfg(bytes32 anchor, uint64 handoff) private view returns (R.Config memory) {
        return R.Config(
            ISP1Verifier(address(sp1)), RELEASE_VKEY, STEP_VKEY, WORDS, anchor, block.chainid, address(token), GENESIS,
            EPOCH, AUTHORITY, 14 days, 3 days, 14 days, handoff
        );
    }

    function switchVault(address lc) private {
        uint256 until = block.timestamp + 100;
        uint64 nonce = vault.switchNonce();
        vault.proposeVerifier(lc, nonce, until, cert(vault.switchDigest(false, lc, lc.codehash, nonce, until), 6));
        vm.warp(block.timestamp + 14 days);
        vault.activateVerifier();
        require(vault.verifier() == lc, "vault switched");
    }

    function switchToken(address v) private {
        uint256 until = block.timestamp + 100;
        uint64 nonce = token.switchNonce();
        token.proposeVerifier(v, nonce, until, mintBlob(token.mintSwitchDigest(false, v, v.codehash, nonce, until), 6));
        vm.warp(block.timestamp + 14 days);
        token.activateVerifier();
        require(token.verifier() == v, "token switched");
    }

    function le(uint64 v) private pure returns (bytes8) {
        bytes memory b = new bytes(8);
        for (uint256 i; i < 8; ++i) b[i] = bytes1(uint8(v >> (8 * i)));
        return bytes8(b);
    }

    function checkpoint(uint64 epoch, bytes32 root, bytes32 stateRoot) private pure returns (bytes memory) {
        return abi.encodePacked(le(epoch), root, stateRoot);
    }

    function stepOut(bytes memory cp) private view returns (bytes memory) {
        return abi.encodePacked("BLOCH-LC-STEP-v1", WORDS, digest, cp);
    }

    function stepProof(bytes memory pv) private pure returns (bytes memory) {
        return abi.encode(keccak256(abi.encode(STEP_VKEY, pv)));
    }

    function epochNow() private view returns (uint64) {
        return uint64((block.timestamp - GENESIS) / EPOCH);
    }

    /// A real deposit (net of the 5 bps fee) and its 5-of-7 committee mint, credited after the 12 h queue.
    function depositAndMint(uint64 gross, address to) private returns (bytes32 id, uint64 net) {
        usdc.mint(address(this), gross);
        id = vault.deposit(gross, bytes32(uint256(uint160(to))));
        uint64 nonce = vault.depositCount() - 1;
        net = gross - gross * 5 / 10_000;
        token.mint(id, nonce, net, to, mintBlob(token.mintDigest(id, nonce, net, to), 5));
        vm.warp(block.timestamp + 12 hours);
        token.executeMint(id);
    }

    /// `n` real 5,000 USDC deposits for Alice, each minted by the committee 12 h apart (the L2 bucket refills 5,000 in 12 h).
    function fund(uint256 n) private {
        for (uint256 i; i < n; ++i) depositAndMint(DEP, ALICE);
    }

    /// A real deposit minted by proof (after the token switch); credited after the 12 h queue.
    function depositAndProve(uint64 gross, address to) private returns (bytes32 id, uint64 net) {
        usdc.mint(address(this), gross);
        id = vault.deposit(gross, bytes32(uint256(uint160(to))));
        uint64 nonce = vault.depositCount() - 1;
        net = gross - gross * 5 / 10_000;
        token.mintWithProof(id, nonce, net, to, abi.encode(id, nonce, net, to));
        vm.warp(block.timestamp + 12 hours);
        token.executeMint(id);
    }

    /// 101's D6 at T = 0: Bob's real deposit waits unminted; 5 mint keys queue a forged mint into its slot for Mallory and
    /// nobody cancels it in 12 h (the guardians missed it, F129-A); it credits.
    function forgeCredit(uint64 amount) private returns (bytes32 id) {
        usdc.mint(address(this), 2000 * U);
        vault.deposit(uint64(2000 * U), bytes32(uint256(uint160(BOB))));
        uint64 slot = token.nextSlot();
        id = fid(keccak256("forged"), slot);
        token.mint(id, slot, amount, MALLORY, mintBlob(token.mintDigest(id, slot, amount, MALLORY), 5));
        vm.warp(block.timestamp + 12 hours);
        token.executeMint(id);
    }

    function burn(address holder, uint64 amount) private returns (TronSourceVault.Release memory r) {
        vm.prank(holder);
        bytes32 burnId = token.burn(amount, holder);
        r = TronSourceVault.Release(
            vault.routeId(), token.burnNonce(), holder, amount, burnId, token.mintCount(), token.mintedTotal(),
            token.mintHead()
        );
    }

    function proofFor(R lc, TronSourceVault.Release memory r) private view returns (bytes memory) {
        bytes memory pv = lc.expectedPublicValues(address(vault), vault.releaseId(r));
        return abi.encode(pv, abi.encode(keccak256(abi.encode(RELEASE_VKEY, pv))));
    }

    function tryRelease(TronSourceVault.Release memory r, bytes memory proof) private returns (bool ok, bytes4 err) {
        bytes memory ret;
        (ok, ret) = address(vault).call(abi.encodeCall(TronSourceVault.releaseWithProof, (r, proof)));
        if (!ok && ret.length >= 4) err = bytes4(ret);
    }

    /// The predicate `verifier_review.py proposal` (R6) evaluates before a switch: the token's credited chain is the vault's.
    function heldState() private view returns (bool) {
        uint64 n = token.mintCount();
        return n > vault.depositCount() || token.mintHead() != vault.chainHeadAt(n);
    }

    // ---------------------------------------------------------------- V1b: held burns at the switch

    /// A forgery credits before the switch. Burns made before it still pay after the switch; every burn after it (Alice's
    /// real tokens included) is refused by the vault before the verifier is even asked, with a valid proof, for good: the
    /// one-way switch is spent, a second proposal reverts, and no LC path changes the vault's deposit chain.
    function test_V1b_heldBurnsStayHeldForGoodAfterTheSwitch() public {
        (, uint64 aliceNet) = depositAndMint(uint64(1000 * U), ALICE);
        TronSourceVault.Release memory before = burn(ALICE, uint64(100 * U));
        require(!heldState(), "clean so far");
        forgeCredit(uint64(500 * U));
        require(heldState(), "R6 sees the held state on chain");
        TronSourceVault.Release memory held = burn(ALICE, uint64(300 * U));

        R lc = new R(cfg(digest, 30 days));
        switchVault(address(lc));
        vault.releaseWithProof(before, proofFor(lc, before));
        require(usdc.balanceOf(ALICE) == 100 * U - 100 * U * 5 / 10_000, "a burn from before the credit pays, less the fee");
        bytes memory proof = proofFor(lc, held);
        require(lc.verifyRelease(address(vault), vault.releaseId(held), proof) == R.verifyRelease.selector, "valid proof");
        (bool ok, bytes4 err) = tryRelease(held, proof);
        require(!ok && err == TronSourceVault.ProvenanceMismatch.selector, "held: Alice's real tokens");
        vm.warp(block.timestamp + 365 days);
        (ok, err) = tryRelease(held, proof);
        require(!ok && err == TronSourceVault.ProvenanceMismatch.selector, "still held a year later");
        uint256 until = block.timestamp + 100;
        uint64 nonce = vault.switchNonce();
        AcceptAll settle = new AcceptAll();
        bytes[] memory sigs = cert(vault.switchDigest(false, address(settle), address(settle).codehash, nonce, until), 6);
        vm.expectRevert(TronSourceVault.InvalidSwitch.selector);
        vault.proposeVerifier(address(settle), nonce, until, sigs);
        require(aliceNet - 400 * U == token.balanceOf(ALICE), "Alice's remaining tokens are real; the vault holds them all");
    }

    /// 172 V1b: before the switch, the switch itself is the only settlement path. A settlement verifier (here an
    /// accept-all stand-in, 6 of 7 and 14 days) pays the held burn when its item names the vault's clean head. That spends
    /// the switch, so the real LC verifier could then never be installed on this vault.
    function test_V1b_beforeTheSwitchOnlyASettlementVerifierPaysAHeldBurn() public {
        depositAndMint(uint64(1000 * U), ALICE);
        forgeCredit(uint64(500 * U));
        TronSourceVault.Release memory held = burn(ALICE, uint64(300 * U));
        AcceptAll settle = new AcceptAll();
        switchVault(address(settle));
        held.mintCount = 1;
        held.mintedTotal = uint64(token.mintedTotal() - 500 * U);
        held.mintHead = vault.chainHeadAt(1);
        vault.releaseWithProof(held, "");
        require(usdc.balanceOf(ALICE) > 0, "settled through the switch");
        R lc = new R(cfg(digest, 30 days));
        uint256 until = block.timestamp + 100;
        uint64 nonce = vault.switchNonce();
        bytes[] memory sigs = cert(vault.switchDigest(false, address(lc), address(lc).codehash, nonce, until), 6);
        vm.expectRevert(TronSourceVault.InvalidSwitch.selector);
        vault.proposeVerifier(address(lc), nonce, until, sigs);
    }

    // ---------------------------------------------------------------- AUTH: what recoveryAuthority can do

    /// With handoff on, the authority alone replaces a WORKING light client with any code after the notice. The
    /// endorsement only proves that the checkpoint the successor reports as its anchor is on the trusted chain (any old step
    /// proof will do); it binds nothing about the successor's code. That code can settle a held burn and can also pay
    /// releases no burn backs, bounded only by the vault window (10,000 a day) and the locked amount. Proofs of life do not
    /// stop it.
    function test_AUTH_handoffInstallsArbitraryCodeOnAWorkingClient() public {
        fund(4);
        forgeCredit(uint64(500 * U));
        TronSourceVault.Release memory held = burn(ALICE, uint64(300 * U));
        R lc = new R(cfg(digest, 30 days));
        switchVault(address(lc));

        bytes memory oldCp = checkpoint(8100, bytes32(uint256(0xC0)), bytes32(uint256(0xC1)));
        A239AnchoredAcceptAllTron evil =
            new A239AnchoredAcceptAllTron(sha256(abi.encodePacked("BLOCH-LC-ANCHOR-v1", oldCp)), address(token), block.chainid);
        vm.prank(AUTHORITY);
        lc.proposeHandoff(address(evil));
        vm.warp(uint256(lc.activatesAt()) - 1 days);
        bytes memory life = stepOut(checkpoint(epochNow() - 1, bytes32(uint256(1)), bytes32(uint256(2))));
        bytes memory lifeProof = stepProof(life);
        vm.expectRevert(R.InvalidLifeProof.selector);
        lc.proveLife(life, lifeProof);
        vm.warp(lc.activatesAt());
        bytes memory pv = stepOut(oldCp);
        lc.endorseHandoff(pv, stepProof(pv));
        lc.activateSuccessor();
        require(lc.successor() == address(evil), "arbitrary successor active");

        held.mintCount = 1;
        held.mintedTotal = NET1;
        held.mintHead = vault.chainHeadAt(1);
        vault.releaseWithProof(held, "");
        require(usdc.balanceOf(ALICE) > 0, "the successor settles a held burn");
        TronSourceVault.Release memory theft = TronSourceVault.Release(
            vault.routeId(), 999, MALLORY, uint64(9_000 * U), keccak256("no burn"), 1, held.mintedTotal, held.mintHead
        );
        vault.releaseWithProof(theft, "");
        require(usdc.balanceOf(MALLORY) > 8_990 * U, "and pays a release no burn backs");
        theft.nonce = 1000;
        theft.nativeBurn = keccak256("no burn 2");
        (bool ok, bytes4 err) = tryRelease(theft, "");
        require(!ok && err == TronSourceVault.RateLimited.selector, "bounded by the vault window only");
    }

    /// With handoff off (handoffDelay 0), the authority cannot replace a working client: no handoff, and any recent
    /// step proof deletes a recovery proposal and starts the cooldown.
    function test_AUTH_handoffOffAWorkingClientCannotBeReplaced() public {
        R lc = new R(cfg(digest, 0));
        switchVault(address(lc));
        AcceptAll evil = new AcceptAll();
        vm.prank(AUTHORITY);
        vm.expectRevert(R.HandoffDisabled.selector);
        lc.proposeHandoff(address(evil));
        vm.prank(AUTHORITY);
        lc.proposeSuccessor(address(evil));
        vm.warp(uint256(lc.activatesAt()) - 1 hours);
        bytes memory life = stepOut(checkpoint(epochNow() - 1, bytes32(uint256(1)), bytes32(uint256(2))));
        lc.proveLife(life, stepProof(life));
        require(lc.proposedSuccessor() == address(0), "stopped by a proof of life");
        vm.prank(AUTHORITY);
        vm.expectRevert(R.InvalidProposal.selector);
        lc.proposeSuccessor(address(evil));
    }

    /// A stopped client and a hostile authority: after recoveryDelay with no proof of life, the authority's arbitrary
    /// successor activates. This is the cost of option 5 in report 103, stated as a test.
    function test_AUTH_stoppedClientAuthorityChoosesAnyCode() public {
        fund(4);
        R lc = new R(cfg(digest, 0));
        switchVault(address(lc));
        AcceptAll evil = new AcceptAll();
        vm.prank(AUTHORITY);
        lc.proposeSuccessor(address(evil));
        vm.warp(lc.activatesAt());
        lc.activateSuccessor();
        TronSourceVault.Release memory theft = TronSourceVault.Release(
            vault.routeId(), 7, MALLORY, uint64(10_000 * U), keccak256("x"), 1, NET1, vault.chainHeadAt(1)
        );
        vault.releaseWithProof(theft, "");
        require(usdc.balanceOf(MALLORY) > 9_990 * U, "one window paid to the authority's code");
    }

    // ---------------------------------------------------------------- META: code hash after activation

    /// Before the A239 fix the vault pinned the verifier's code hash only up to `activateVerifier`, and code that changed
    /// after activation (a metamorphic redeploy, simulated with etch) paid a release no burn backs (commit a79df21: this
    /// test then asserted the payment). `releaseWithProof` now re-checks the pinned hash, as the token's `mintWithProof`
    /// has since 807ac51 (F171-4).
    function test_META_vaultAndTokenRefuseCodeChangedAfterActivation() public {
        fund(4);
        R lc = new R(cfg(digest, 0));
        switchVault(address(lc));
        vm.etch(address(lc), address(new AcceptAll()).code);
        TronSourceVault.Release memory theft = TronSourceVault.Release(
            vault.routeId(), 7, MALLORY, uint64(5_000 * U), keccak256("x"), 1, NET1, vault.chainHeadAt(1)
        );
        (bool ok, bytes4 err) = tryRelease(theft, "");
        require(!ok && err == TronSourceVault.InvalidProof.selector, "vault: swapped code refused");

        A239DepositMintVerifierTron mv = new A239DepositMintVerifierTron(vault);
        switchToken(address(mv));
        vm.etch(address(mv), address(new AcceptAll()).code);
        usdc.mint(address(this), 100 * U);
        bytes32 id = vault.deposit(uint64(100 * U), bytes32(uint256(uint160(BOB))));
        uint64 nonce = vault.depositCount() - 1;
        vm.expectRevert(BridgedStablecoinV2.InvalidProof.selector);
        token.mintWithProof(id, nonce, uint64(1_000 * U), MALLORY, "");
    }

    /// The same gap one level down, closed the same way: RecoverableReleaseVerifier used to pin its successor's code hash
    /// only at activation (commit a79df21: this test asserted the payment); `verifyRelease` now refuses changed code.
    function test_META_recoverableRefusesASuccessorWhoseCodeChanged() public {
        fund(4);
        R lc = new R(cfg(digest, 0));
        switchVault(address(lc));
        R next = new R(cfg(sha256(abi.encodePacked("BLOCH-LC-ANCHOR-v1", checkpoint(9000, bytes32(uint256(9)), 0))), 0));
        vm.prank(AUTHORITY);
        lc.proposeSuccessor(address(next));
        vm.warp(lc.activatesAt());
        lc.activateSuccessor();
        vm.etch(address(next), address(new AcceptAll()).code);
        TronSourceVault.Release memory theft = TronSourceVault.Release(
            vault.routeId(), 7, MALLORY, uint64(5_000 * U), keccak256("x"), 1, NET1, vault.chainHeadAt(1)
        );
        (bool ok, bytes4 err) = tryRelease(theft, "");
        require(!ok && err == TronSourceVault.InvalidProof.selector, "successor's swapped code refused");
        require(usdc.balanceOf(MALLORY) == 0, "nothing paid");
    }

    // ---------------------------------------------------------------- ORDER: token mint path first (172 decision 2)

    /// Vault first: the committee still mints on L2. A forgery credited after the vault switch holds every later burn for
    /// good, and the spent switch leaves no settlement path at all (before the switch, V1b had one).
    function test_ORDER_vaultFirstALaterCommitteeForgeryIsPermanent() public {
        depositAndMint(uint64(1000 * U), ALICE);
        R lc = new R(cfg(digest, 0));
        switchVault(address(lc));
        forgeCredit(uint64(500 * U));
        TronSourceVault.Release memory held = burn(ALICE, uint64(300 * U));
        (bool ok, bytes4 err) = tryRelease(held, proofFor(lc, held));
        require(!ok && err == TronSourceVault.ProvenanceMismatch.selector, "held");
        uint256 until = block.timestamp + 100;
        uint64 nonce = vault.switchNonce();
        AcceptAll settle = new AcceptAll();
        bytes[] memory sigs = cert(vault.switchDigest(false, address(settle), address(settle).codehash, nonce, until), 6);
        vm.expectRevert(TronSourceVault.InvalidSwitch.selector);
        vault.proposeVerifier(address(settle), nonce, until, sigs);
    }

    /// Token first: once the token's mint path is on proofs the committee cannot mint, so no forgery can credit; the vault
    /// switch after it pays honest burns and nothing can hold them.
    function test_ORDER_tokenFirstThenVaultHonestExitsCannotBeHeld() public {
        depositAndMint(uint64(1000 * U), ALICE);
        A239DepositMintVerifierTron mv = new A239DepositMintVerifierTron(vault);
        switchToken(address(mv));
        usdc.mint(address(this), 2000 * U);
        bytes32 bobId = vault.deposit(uint64(2000 * U), bytes32(uint256(uint160(BOB))));
        uint64 slot = token.nextSlot();
        bytes32 fake = fid(keccak256("forged"), slot);
        bytes memory blob = mintBlob(token.mintDigest(fake, slot, uint64(500 * U), MALLORY), 5);
        vm.expectRevert(BridgedStablecoinV2.CommitteeRetired.selector);
        token.mint(fake, slot, uint64(500 * U), MALLORY, blob);
        vm.expectRevert(BridgedStablecoinV2.InvalidProof.selector);
        token.mintWithProof(fake, slot, uint64(500 * U), MALLORY, abi.encode(fake, slot, uint64(500 * U), MALLORY));
        uint64 bobNet = uint64(2000 * U - 2000 * U * 5 / 10_000);
        token.mintWithProof(bobId, slot, bobNet, BOB, abi.encode(bobId, slot, bobNet, BOB));
        R lc = new R(cfg(digest, 0));
        switchVault(address(lc));
        token.executeMint(bobId);
        depositAndProve(uint64(500 * U), ALICE);
        require(!heldState(), "no held state can arise");
        TronSourceVault.Release memory r = burn(ALICE, uint64(400 * U));
        vault.releaseWithProof(r, proofFor(lc, r));
        require(usdc.balanceOf(ALICE) == 400 * U - 400 * U * 5 / 10_000, "paid by proof, less the fee");
    }

    /// What the order alone misses: the token switch does not empty the committee's queue. A forged committee mint queued
    /// before the token switch still credits by `executeMint` after it (anyone may call it; only guardians can cancel it).
    /// So the gate before the vault switch must also check that no committee-queued mint is still pending (R6).
    function test_ORDER_tokenSwitchLeavesTheCommitteeQueueExecutable() public {
        depositAndMint(uint64(1000 * U), ALICE);
        A239DepositMintVerifierTron mv = new A239DepositMintVerifierTron(vault);
        uint256 until = block.timestamp + 100;
        token.proposeVerifier(
            address(mv), 0, until, mintBlob(token.mintSwitchDigest(false, address(mv), address(mv).codehash, 0, until), 6)
        );
        vm.warp(block.timestamp + 14 days - 1 hours);
        usdc.mint(address(this), 2000 * U);
        vault.deposit(uint64(2000 * U), bytes32(uint256(uint160(BOB))));
        uint64 slot = token.nextSlot();
        bytes32 fake = fid(keccak256("forged"), slot);
        token.mint(fake, slot, uint64(500 * U), MALLORY, mintBlob(token.mintDigest(fake, slot, uint64(500 * U), MALLORY), 5));
        vm.warp(block.timestamp + 1 hours);
        token.activateVerifier();
        require(token.verifier() == address(mv) && token.pendingCount() == 1, "switched with a committee mint queued");
        vm.warp(block.timestamp + 12 hours);
        token.executeMint(fake);
        require(token.balanceOf(MALLORY) == 500 * U && heldState(), "the forgery credits after the token switch");
    }

    /// Execution gas of one honest `releaseWithProof` through RecoverableReleaseVerifier (mock SP1), as measured by
    /// gasleft around the call. Compare with the same test at a commit without the code-hash re-check.
    function test_GAS_releaseWithProofThroughRecoverable() public {
        depositAndMint(uint64(1000 * U), ALICE);
        R lc = new R(cfg(digest, 0));
        switchVault(address(lc));
        TronSourceVault.Release memory r = burn(ALICE, uint64(400 * U));
        bytes memory proof = proofFor(lc, r);
        uint256 g = gasleft();
        vault.releaseWithProof(r, proof);
        g -= gasleft();
        emit GasUsed("releaseWithProof via Recoverable", g);
    }

    event GasUsed(string what, uint256 gas);

    // ---------------------------------------------------------------- the R6 predicate agrees with the vault

    /// `heldState()` (what the tool reads: token mintCount/mintHead against vault.chainHeadAt) is false exactly when a burn
    /// made now would pass the vault's provenance check.
    function test_GATE_heldPredicateMatchesTheVault() public {
        depositAndMint(uint64(1000 * U), ALICE);
        depositAndMint(uint64(700 * U), BOB);
        require(!heldState(), "honest");
        TronSourceVault.Release memory r = burn(ALICE, uint64(50 * U));
        require(vault.provenanceMatches(r.mintCount, r.mintedTotal, r.mintHead), "vault agrees: clean");
        forgeCredit(uint64(10 * U));
        require(heldState(), "held");
        r = burn(BOB, uint64(50 * U));
        require(!vault.provenanceMatches(r.mintCount, r.mintedTotal, r.mintHead), "vault agrees: held");
    }
}
