/// Stands for an Ethereum light-client mint verifier on the L2: it accepts a mint only for a deposit that really exists in
/// the vault with exactly these fields (the test reads the vault directly; the real one would prove its log).
contract A239DepositMintVerifierTron is IMintVerifier {
    TronSourceVault public immutable vault;

    constructor(TronSourceVault vault_) {
        vault = vault_;
    }

    function verifyMint(address token, bytes32 mintHash, bytes calldata proof) external view returns (bytes4) {
        (bytes32 id, uint64 nonce, uint64 amount, address recipient) = abi.decode(proof, (bytes32, uint64, uint64, address));
        BridgedStablecoinV2 t = BridgedStablecoinV2(token);
        bytes32 h = keccak256(
            abi.encode(t.MINT_TYPEHASH(), t.sourceChainId(), t.sourceVault(), t.sourceRoute(), id, nonce, amount, recipient)
        );
        require(h == mintHash && vault.depositMatches(nonce, id, amount, recipient), "no such deposit");
        return IMintVerifier.verifyMint.selector;
    }
}

/// A handoff successor written by a hostile (or merely careless) recovery authority: it reports, as its anchor, a checkpoint
