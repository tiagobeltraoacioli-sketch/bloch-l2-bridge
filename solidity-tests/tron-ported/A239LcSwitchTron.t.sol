/// bucket and window 10,000 a day, cap 100,000. Mock SP1 (`RMockSP1`).
///
/// Questions answered here:
///   V1b  what happens to held burns at the switch (they stay held for good; nothing in the LC path settles them);
///   AUTH what `recoveryAuthority` can do after the switch (with handoff on: install any code after the notice);
///   META whether the vault re-checks the verifier's code hash after activation (it does not; the token does since 807ac51);
///   ORDER 172 decision 2: token mint path to proofs before the vault release path, and what the order alone misses.
contract A239LcSwitchTestTron {
    A239VmTron constant vm = A239VmTron(address(uint160(uint256(keccak256("hevm cheat code")))));
    uint256 constant U = 1e6;
    uint64 constant CAP = uint64(100_000 * U);
    uint64 constant BUCKET = uint64(10_000 * U);
    uint64 constant MIN_BURN = uint64(10 * U);
    uint64 constant DEP = uint64(5_000 * U);
    uint64 constant NET1 = DEP - DEP * 5 / 10_000;
    bytes32 constant RELEASE_VKEY = keccak256("release");
    bytes32 constant STEP_VKEY = keccak256("step");
    bytes32 constant WORDS = keccak256("step words");
    address constant AUTHORITY = address(0xA11CE5);
    address constant ALICE = address(0xA11CE);
    address constant BOB = address(0xB0B);
    address constant MALLORY = address(0xBAD);
    uint64 constant GENESIS = 1786656679;
    uint64 constant EPOCH = 960;

    uint256[] mintKeys;
    uint256[] ethKeys;
    D6UsdcTron usdc;
    RMockSP1 sp1;
    TronSourceVault vault;
    BridgedStablecoinV3 token;
    bytes anchorCp;
    bytes32 digest;

    function setUp() public {
        vm.roll(1000);
        vm.warp(uint256(GENESIS) + 8000 * EPOCH);
        mintKeys = sortedKeys(0x1000);
        ethKeys = sortedKeys(0x2000);
        usdc = new D6UsdcTron();
        sp1 = new RMockSP1();
        anchorCp = checkpoint(7999, bytes32(uint256(0xA0)), bytes32(uint256(0xA1)));
        digest = sha256(abi.encodePacked("BLOCH-LC-ANCHOR-v1", anchorCp));
        vault = new TronSourceVault(
            keccak256("ethereum"), keccak256("bloch-l2"), keccak256("USDC"), address(usdc), CAP, 1, addrs(ethKeys), 5,
            TronSourceVault.Policy(BUCKET, 1 days, 6, 14 days, uint64(11 * U), MIN_BURN),
            TronSourceVault.Guard(new address[](0), 0, 0),
            TronSourceVault.Provenance(1, 0, address(0), TronSourceVault.Fees(address(0xFEE), 5, 5, 0))
        );
        uint256 until = block.timestamp + 100;
        vault.setControls(true, true, 0, until, cert(vault.controlDigest(true, true, 0, until), 5));
        token = new BridgedStablecoinV3(
            "Bloch Bridged USDC", "bUSDC", block.chainid, address(vault), vault.routeId(), addrs(mintKeys), 5,
            SignerMintedToken.Limits(CAP, BUCKET, BUCKET / 1 days, 0, 12 hours, MIN_BURN),
            SignerMintedToken.Guard(new address[](0), 0, 0), BridgedStablecoinV2.MintSwitch(6, 14 days)
        );
        require(token.mintHead() == vault.mintChainGenesis(), "same genesis on both sides");
