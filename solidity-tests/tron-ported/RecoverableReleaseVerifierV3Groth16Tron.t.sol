/// @notice REAL SP1 6.8.0 Groth16 release proofs of agent 130's release guest (step ELF unchanged) over a burn of the
///         V3 launch tip 9f91a56 at T = 0, through RecoverableReleaseVerifier (handoff 30 d) and SP1VerifierGroth16
///         v6.1.0. The proofs commit the v2 release id that this branch's TronSourceVault computes from the
///         `Burned` log, mint-chain fields included. The vault's provenance refusal of the forged burn is shown on
///         anvil (agents/138-v3-lc-merge.md); here the verifier accepts both, as it must. See the vector's `note`.
contract RecoverableReleaseVerifierV3Groth16TestTron {
    G3VmTron private constant vm = G3VmTron(address(uint160(uint256(keccak256("hevm cheat code")))));
    string private constant V = "test-vectors/sp1-release-lc-guests/release-v3-9f91a56-groth16.json";

    string private j;
    R private lc;
    TronSourceVault private ids;

    function setUp() public {
        j = vm.readFile(V);
        vm.chainId(vm.parseJsonUint(j, ".chain_id"));
        SP1VerifierGroth16 sp1 = new SP1VerifierGroth16();
        lc = new R(
            R.Config(
                ISP1Verifier(address(sp1)), vm.parseJsonBytes32(j, ".program_vkey"), vm.parseJsonBytes32(j, ".step_vkey"),
                vm.parseJsonBytes32(j, ".step_vkey_words"), vm.parseJsonBytes32(j, ".anchor_digest"),
                vm.parseJsonUint(j, ".l2_chain_id"), vm.parseJsonAddress(j, ".l2_token"), 1786656679, 960,
                address(0xA11CE), 14 days, 3 days, 14 days, 30 days
            )
        );
        // Any instance computes the (pure) v2 release id.
        address[] memory s = new address[](7);
        for (uint256 i; i < 7; ++i) s[i] = vm.addr(0x2000 + i);
        for (uint256 i; i < 7; ++i) {
            for (uint256 k = i + 1; k < 7; ++k) {
                if (s[k] < s[i]) (s[i], s[k]) = (s[k], s[i]);
            }
        }
        ids = new TronSourceVault(
            keccak256("ethereum"), keccak256("bloch-l2"), keccak256("USDC"), address(new D6UsdcTron()), 100_000e6, 1, s, 5,
            TronSourceVault.Policy(10_000e6, 1 days, 6, 14 days, 10e6, 10e6),
            TronSourceVault.Guard(new address[](0), 0, 0),
            TronSourceVault.Provenance(1, 0, address(0), TronSourceVault.Fees(address(0), 0, 0, 0))
        );
    }

    function item(string memory t) private view returns (TronSourceVault.Release memory) {
        return TronSourceVault.Release(
            vm.parseJsonBytes32(j, string.concat(".", t, ".route")), uint64(vm.parseJsonUint(j, string.concat(".", t, ".nonce"))),
            vm.parseJsonAddress(j, string.concat(".", t, ".recipient")), uint64(vm.parseJsonUint(j, string.concat(".", t, ".amount"))),
            vm.parseJsonBytes32(j, string.concat(".", t, ".native_burn")),
            uint64(vm.parseJsonUint(j, string.concat(".", t, ".mint_count"))),
            uint64(vm.parseJsonUint(j, string.concat(".", t, ".minted_total"))),
            vm.parseJsonBytes32(j, string.concat(".", t, ".mint_head"))
        );
    }

    function proof(string memory t) private view returns (bytes memory) {
        return abi.encode(vm.parseJsonBytes(j, string.concat(".", t, ".public_values")), vm.parseJsonBytes(j, string.concat(".", t, ".proof")));
    }

    function testTrustAnchorIsTheOneTheGuestCommitted() public view {
        require(lc.trustAnchor() == vm.parseJsonBytes32(j, ".trust_anchor"), "anchor");
    }

    function testTheProofsCommitThisVaultsReleaseIds() public view {
        require(ids.releaseId(item("honest")) == vm.parseJsonBytes32(j, ".honest.release_id"), "honest id");
        require(ids.releaseId(item("forged")) == vm.parseJsonBytes32(j, ".forged.release_id"), "forged id");
    }

    function testBothRealProofsVerify() public view {
        address vault = vm.parseJsonAddress(j, ".vault");
        require(
            lc.verifyRelease(vault, vm.parseJsonBytes32(j, ".honest.release_id"), proof("honest"))
                == IReleaseVerifier.verifyRelease.selector,
            "honest"
        );
        require(
            lc.verifyRelease(vault, vm.parseJsonBytes32(j, ".forged.release_id"), proof("forged"))
                == IReleaseVerifier.verifyRelease.selector,
            "forged (the vault, not the verifier, refuses it)"
        );
    }

    function testAProofIsBoundToItsReleaseAndVault() public {
        address vault = vm.parseJsonAddress(j, ".vault");
        bytes memory p = proof("honest");
        bytes32 forged = vm.parseJsonBytes32(j, ".forged.release_id");
        vm.expectRevert(R.PublicValuesMismatch.selector);
        lc.verifyRelease(vault, forged, p);
        bytes32 honest = vm.parseJsonBytes32(j, ".honest.release_id");
        vm.expectRevert(R.PublicValuesMismatch.selector);
        lc.verifyRelease(address(ids), honest, p);
    }

    function testATamperedRealProofIsRefused() public {
        bytes memory pb = vm.parseJsonBytes(j, ".honest.proof");
        pb[pb.length - 1] = bytes1(uint8(pb[pb.length - 1]) ^ 1);
        bytes memory p = abi.encode(vm.parseJsonBytes(j, ".honest.public_values"), pb);
        address vault = vm.parseJsonAddress(j, ".vault");
        bytes32 honest = vm.parseJsonBytes32(j, ".honest.release_id");
        vm.expectRevert();
        lc.verifyRelease(vault, honest, p);
    }
}
