interface FeeVmTron {
    function addr(uint256 privateKey) external pure returns (address);
    function sign(uint256 privateKey, bytes32 digest) external pure returns (uint8 v, bytes32 r, bytes32 s);
    function warp(uint256 timestamp) external;
    function roll(uint256 blockNumber) external;
    function prank(address sender) external;
    function setBlockhash(uint256 blockNumber, bytes32 hash) external;
    function expectRevert(bytes4 revertData) external;
}

/// Six-decimal USDC stand-in. `leak` models a balance the vault loses outside its own accounting.
contract FeeUsdcTron {
    // TRON port: the two TetherToken getters TronSourceVault requires (TRON-3, TRON-4), always false.
    function isBlackListed(address) external pure returns (bool) {
        return false;
    }

    function deprecated() external pure returns (bool) {
        return false;
    }

    uint8 public constant decimals = 6;
    mapping(address => uint256) public balanceOf;

    function mint(address to, uint256 amount) external {
        balanceOf[to] += amount;
    }

    function leak(address from, uint256 amount) external {
        balanceOf[from] -= amount;
    }

    function transferFrom(address from, address to, uint256 amount) external returns (bool) {
        balanceOf[from] -= amount;
        balanceOf[to] += amount;
        return true;
    }

    function transfer(address to, uint256 amount) external returns (bool) {
        balanceOf[msg.sender] -= amount;
        balanceOf[to] += amount;
        return true;
    }
}

/// Agent 197: the protocol fee on the bUSDC V3 route, at the launch shape of agent 175 (T = 0, 12 h delay, 5-of-7 mint
/// and release, 10,000 USDC bucket and window, 100,000 cap, minBurn 10) with 5 bps on deposit and 5 bps on release.
/// Properties: the fee never enters backing (vault USDC == totalLocked + feesAccrued, bUSDC supply <= totalLocked);
/// the mint chain, cancel and remint, the cap and the release bucket keep working on net amounts; only the immutable
/// recipient can receive fees and only through `sweepFees`.
contract R197BridgeFeeTestTron {
    FeeVmTron constant vm = FeeVmTron(address(uint160(uint256(keccak256("hevm cheat code")))));
    uint256 constant U = 1e6;
    uint64 constant BUCKET = uint64(10_000 * U);
    uint64 constant CAP = uint64(100_000 * U);
    uint64 constant MIN_BURN = uint64(10 * U);
    uint64 constant MIN_DEPOSIT = uint64(11 * U);
    uint16 constant DEP_BPS = 5;
    uint16 constant REL_BPS = 5;
    address constant TREASURY = address(0x7EA5);
    address constant ALICE = address(0xA11CE);
    address constant BOB = address(0xB0B);

    uint256[] mintKeys;
    uint256[] ethKeys;
    uint256[3] guardKeys = [uint256(0x6a01), 0x6a02, 0x6a03];
    FeeUsdcTron usdc;
    TronSourceVault vault;
    BridgedStablecoinV3 token;

    function setUp() public {
        vm.warp(1_000_000);
        vm.roll(1000);
        mintKeys = sorted(0x1000);
        ethKeys = sorted(0x2000);
        usdc = new FeeUsdcTron();
        vault = deployVault(TronSourceVault.Fees(TREASURY, DEP_BPS, REL_BPS, 0), MIN_DEPOSIT, 0);
        token = deployToken(vault);
    }

    function deployVault(TronSourceVault.Fees memory fees, uint64 minDeposit, uint64 releaseDelay)
        internal
        returns (TronSourceVault v)
    {
        v = new TronSourceVault(
            keccak256("ethereum"), keccak256("bloch-l2"), keccak256("USDC"), address(usdc), CAP, 1, addrs(ethKeys), 5,
            TronSourceVault.Policy(BUCKET, 1 days, 6, 14 days, minDeposit, MIN_BURN),
            TronSourceVault.Guard(new address[](0), 0, 0),
            TronSourceVault.Provenance(1, releaseDelay, address(0), fees)
        );
        uint256 until = block.timestamp + 100;
        v.setControls(true, true, 0, until, cert(v.controlDigest(true, true, 0, until), 5));
    }

    function deployToken(TronSourceVault v) internal returns (BridgedStablecoinV3 t) {
        address[] memory g = new address[](3);
        for (uint256 i; i < 3; ++i) g[i] = vm.addr(guardKeys[i]);
        t = new BridgedStablecoinV3(
            "Bloch Bridged USDC", "bUSDC", block.chainid, address(v), v.routeId(), addrs(mintKeys), 5,
            SignerMintedToken.Limits(CAP, BUCKET, BUCKET / 1 days, 0, 12 hours, MIN_BURN),
            SignerMintedToken.Guard(g, 3 days, 3 days), BridgedStablecoinV2.MintSwitch(6, 14 days)
        );
    }

    // ---------------------------------------------------------------- helpers

    function sorted(uint256 base) internal view returns (uint256[] memory k) {
        k = new uint256[](7);
        for (uint256 i; i < 7; ++i) k[i] = base + i;
        for (uint256 i; i < 7; ++i) {
            for (uint256 j = i + 1; j < 7; ++j) {
                if (vm.addr(k[j]) < vm.addr(k[i])) (k[i], k[j]) = (k[j], k[i]);
            }
        }
    }

    function addrs(uint256[] memory k) internal view returns (address[] memory a) {
        a = new address[](k.length);
        for (uint256 i; i < k.length; ++i) a[i] = vm.addr(k[i]);
    }

    function cert(bytes32 digest, uint256 n) internal view returns (bytes[] memory out) {
        out = new bytes[](n);
        for (uint256 i; i < n; ++i) {
            (uint8 v, bytes32 r, bytes32 s) = vm.sign(ethKeys[i], digest);
            out[i] = abi.encodePacked(r, s, v);
        }
    }

    function blob(bytes32 digest, uint256 n) internal view returns (bytes memory out) {
        for (uint256 i; i < n; ++i) {
            (uint8 v, bytes32 r, bytes32 s) = vm.sign(mintKeys[i], digest);
            out = bytes.concat(out, abi.encodePacked(r, s, v));
        }
    }

    function fee(uint64 amount, uint16 bps) internal pure returns (uint64) {
        return uint64(uint256(amount) * bps / 10_000);
    }

    /// Deposit `gross` USDC for `l2`; returns the id and the net amount the vault recorded (what the relayer mints).
    function deposit(uint64 gross, address l2) internal returns (bytes32 id, uint64 nonce, uint64 net) {
        usdc.mint(address(this), gross);
        nonce = vault.depositCount();
        id = vault.deposit(gross, bytes32(uint256(uint160(l2))));
        net = gross - fee(gross, DEP_BPS);
        require(vault.depositMatches(nonce, id, net, l2), "the deposit is recorded at its net amount");
    }

    function mintAndCredit(bytes32 id, uint64 nonce, uint64 amount, address to) internal {
        token.mint(id, nonce, amount, to, blob(token.mintDigest(id, nonce, amount, to), 5));
        vm.warp(block.timestamp + 12 hours);
        token.executeMint(id);
    }

    function burn(address holder, uint64 amount) internal returns (TronSourceVault.Release memory) {
        vm.prank(holder);
        bytes32 burnId = token.burn(amount, holder);
        return TronSourceVault.Release(
            vault.routeId(), token.burnNonce(), holder, amount, burnId, token.mintCount(), token.mintedTotal(), token.mintHead()
        );
    }

    function release(TronSourceVault.Release memory r) internal returns (bool ok) {
        (ok,) = releaseRaw(r);
    }

    function releaseRaw(TronSourceVault.Release memory r) internal returns (bool ok, bytes memory ret) {
        vm.roll(block.number + 1);
        vm.setBlockhash(block.number - 1, keccak256(abi.encode(block.number)));
        TronSourceVault.ReleaseContext memory c = TronSourceVault.ReleaseContext(
            block.timestamp + 100, block.number - 1, keccak256(abi.encode(block.number)), 7, keccak256("l2")
        );
        (ok, ret) = address(vault).call(abi.encodeCall(TronSourceVault.release, (r, c, cert(vault.releaseDigest(r, c), 5))));
    }

    /// The backing invariants, checked after every step.
    function backed() internal view {
        require(usdc.balanceOf(address(vault)) == uint256(vault.totalLocked()) + vault.feesAccrued(), "vault == locked + fees");
        require(token.totalSupply() <= vault.totalLocked(), "every bUSDC is backed by locked USDC");
    }

    // ---------------------------------------------------------------- tests

    function test_deployedFeeIsFixedAndReadable() public view {
        require(vault.feeRecipient() == TREASURY, "recipient");
        require(vault.depositFeeBps() == DEP_BPS && vault.releaseFeeBps() == REL_BPS, "rates");
        require(vault.MAX_FEE_BPS() == 30, "ceiling 0.30%");
        require(vault.feesAccrued() == 0, "nothing accrued");
    }

    /// Deposit: the user pays gross, the chain, the id, the log and `totalLocked` carry the net amount; the mint of the
    /// net amount extends the token's chain to the vault's head.
    function test_depositFeeKeepsTheMintChainOnNet() public {
        (bytes32 id, uint64 nonce, uint64 net) = deposit(uint64(1000 * U), ALICE);
        require(net == 999_500_000, "1000 USDC less 5 bps");
        require(vault.totalLocked() == net && vault.feesAccrued() == 500_000, "net locked, fee aside");
        require(id == vault.depositId(nonce, address(this), net, bytes32(uint256(uint160(ALICE)))), "id over net");
        mintAndCredit(id, nonce, net, ALICE);
        require(token.mintHead() == vault.depositHead(1), "token chain == vault chain");
        require(vault.provenanceMatches(token.mintCount(), token.mintedTotal(), token.mintHead()), "provenance");
        require(token.balanceOf(ALICE) == net, "Alice holds the net amount");
        backed();
    }

    /// A relayer that mints the GROSS amount (ignoring the log) leaves the token off the vault's chain: that burn and
    /// every later one cannot be paid. The fee cannot be minted as unbacked bUSDC.
    function test_grossMintIsNeverPaid() public {
        uint64 gross = uint64(1000 * U);
        (bytes32 id, uint64 nonce,) = deposit(gross, ALICE);
        deposit(gross, BOB); // unminted, so totalLocked covers a gross burn and the provenance check is what refuses
        mintAndCredit(id, nonce, gross, ALICE);
        require(token.mintHead() != vault.depositHead(1), "off the chain");
        (bool ok, bytes memory ret) = releaseRaw(burn(ALICE, gross));
        require(!ok && bytes4(ret) == TronSourceVault.ProvenanceMismatch.selector, "refused: ProvenanceMismatch");
        require(usdc.balanceOf(ALICE) == 0, "nothing paid");
    }

    /// Release: the recipient gets amount less 5 bps; `totalLocked` drops by the full burned amount; the bucket takes the
    /// full amount; the fee joins `feesAccrued`.
    function test_releaseFeePaysNetAndUnlocksTheBurn() public {
        (bytes32 id, uint64 nonce, uint64 net) = deposit(uint64(2000 * U), ALICE);
        mintAndCredit(id, nonce, net, ALICE);
        uint256 bucketBefore = vault.availableToRelease();
        uint64 feesBefore = vault.feesAccrued();
        require(release(burn(ALICE, net)), "paid");
        uint64 rf = fee(net, REL_BPS);
        require(usdc.balanceOf(ALICE) == net - rf, "net of the release fee");
        require(vault.totalLocked() == 0 && token.totalSupply() == 0, "fully unlocked and burned");
        require(vault.feesAccrued() == feesBefore + rf, "fee accrued");
        require(bucketBefore - vault.availableToRelease() == net, "bucket debits the burned amount");
        require(usdc.balanceOf(address(vault)) == vault.feesAccrued(), "only fees remain");
        backed();
    }

    /// Several users, partial burns, interleaved: the invariants hold at every step and the vault ends holding exactly
    /// the fees.
    function test_backingHoldsOverInterleavedRoundTrips() public {
        (bytes32 a, uint64 na, uint64 neta) = deposit(uint64(3333_333_333), ALICE);
        backed();
        (bytes32 b, uint64 nb, uint64 netb) = deposit(uint64(777_777_777), BOB);
        backed();
        mintAndCredit(a, na, neta, ALICE);
        backed();
        require(release(burn(ALICE, uint64(1234_567_891))), "Alice part 1");
        backed();
        mintAndCredit(b, nb, netb, BOB);
        backed();
        require(release(burn(BOB, netb)), "Bob");
        backed();
        require(release(burn(ALICE, neta - 1234_567_891)), "Alice rest");
        backed();
        require(vault.totalLocked() == 0 && token.totalSupply() == 0, "empty");
        uint256 paid = usdc.balanceOf(ALICE) + usdc.balanceOf(BOB);
        require(paid + vault.feesAccrued() == 3333_333_333 + 777_777_777, "users + fees == deposits, to the unit");
    }

    /// Anyone sweeps; only the immutable recipient receives; backing is untouched; releases keep paying afterwards.
    function test_sweepPaysOnlyTheRecipientAndNeverBacking() public {
        (bytes32 a, uint64 na, uint64 neta) = deposit(uint64(5000 * U), ALICE);
        mintAndCredit(a, na, neta, ALICE);
        uint64 accrued = vault.feesAccrued();
        vm.prank(BOB);
        require(vault.sweepFees() == accrued, "swept by a stranger");
        require(usdc.balanceOf(TREASURY) == accrued && usdc.balanceOf(BOB) == 0, "to the recipient only");
        require(vault.feesAccrued() == 0 && usdc.balanceOf(address(vault)) == vault.totalLocked(), "backing untouched");
        require(vault.sweepFees() == 0, "nothing twice");
        require(release(burn(ALICE, neta)), "Alice still paid in full less the release fee");
        backed();
    }

    /// If the vault ever holds less than locked + fees, sweep and deposit both refuse: fees never come out of backing.
    function test_sweepAndDepositRefuseWhenShort() public {
        (bytes32 a, uint64 na, uint64 neta) = deposit(uint64(1000 * U), ALICE);
        mintAndCredit(a, na, neta, ALICE);
        usdc.leak(address(vault), 1);
        vm.expectRevert(TronSourceVault.InsufficientBacking.selector);
        vault.sweepFees();
        usdc.mint(address(this), 1000 * U);
        vm.expectRevert(TronSourceVault.InsufficientBacking.selector);
        vault.deposit(uint64(1000 * U), bytes32(uint256(uint160(BOB))));
    }

    /// Guardian cancel and the 6-of-7 remint work on the net amount; the remint lands on the vault's chain.
    function test_cancelAndRemintOnNet() public {
        (bytes32 a, uint64 na, uint64 neta) = deposit(uint64(500 * U), ALICE);
        token.mint(a, na, neta, ALICE, blob(token.mintDigest(a, na, neta, ALICE), 5));
        (address r, uint64 amt, uint64 ready) = token.pendingMints(a);
        for (uint256 i; i < 2; ++i) {
            vm.prank(vm.addr(guardKeys[i]));
            token.voteCancelMint(a, r, amt, ready);
        }
        token.remint(a, na, neta, ALICE, false, blob(token.remintDigest(a, na, neta, ALICE, false), 5));
        vm.warp(block.timestamp + 12 hours);
        token.executeMint(a);
        require(token.mintHead() == vault.depositHead(1), "remint on the chain");
        require(release(burn(ALICE, neta)), "paid");
        backed();
    }

    /// The cap counts net amounts: a deposit whose net lands exactly on the cap passes, one unit more is refused.
    function test_capCountsNet() public {
        for (uint256 i; i < 10; ++i) deposit(BUCKET, ALICE); // 10 x 9,995 net: 50 USDC of room
        uint64 room = CAP - vault.totalLocked();
        // gross g with g - floor(g * 5 / 10000) == room
        uint64 g = uint64((uint256(room) * 10_000 + 9_994) / 9_995);
        while (g - fee(g, DEP_BPS) > room) --g;
        while (g + 1 - fee(g + 1, DEP_BPS) <= room) ++g;
        require(g > room, "the gross amount is above the room; only its net fits");
        deposit(g, BOB);
        require(vault.totalLocked() == CAP, "exactly at the cap");
        usdc.mint(address(this), MIN_DEPOSIT);
        vm.expectRevert(TronSourceVault.InvalidTransfer.selector);
        vault.deposit(MIN_DEPOSIT, bytes32(uint256(uint160(BOB))));
        backed();
    }

    /// The release-delay path (`executeRelease`) charges the same fee once, at payment.
    function test_queuedReleaseChargesAtExecution() public {
        vault = deployVault(TronSourceVault.Fees(TREASURY, DEP_BPS, REL_BPS, 0), MIN_DEPOSIT, 1 days);
        token = deployToken(vault);
        (bytes32 a, uint64 na, uint64 neta) = deposit(uint64(1000 * U), ALICE);
        mintAndCredit(a, na, neta, ALICE);
        TronSourceVault.Release memory r = burn(ALICE, neta);
        require(release(r), "queued");
        require(usdc.balanceOf(ALICE) == 0, "not yet");
        vm.warp(block.timestamp + 1 days);
        vault.executeRelease(vault.releaseId(r));
        require(usdc.balanceOf(ALICE) == neta - fee(neta, REL_BPS), "net of the fee");
        backed();
    }

    /// A zero-fee vault behaves exactly as before: gross == net, nothing accrues, sweep is a no-op.
    function test_zeroFeeIsThePreviousBehaviour() public {
        vault = deployVault(TronSourceVault.Fees(address(0), 0, 0, 0), MIN_BURN, 0);
        token = deployToken(vault);
        usdc.mint(address(this), 1000 * U);
        bytes32 id = vault.deposit(uint64(1000 * U), bytes32(uint256(uint160(ALICE))));
        mintAndCredit(id, 0, uint64(1000 * U), ALICE);
        require(release(burn(ALICE, uint64(1000 * U))), "paid");
        require(usdc.balanceOf(ALICE) == 1000 * U && vault.feesAccrued() == 0 && vault.sweepFees() == 0, "no fee");
    }

    /// The constructor refuses: a rate above 30 bps, a fee with no recipient, a recipient with no fee, the token as
    /// recipient, and a minimum deposit whose net is below the L2 minimum burn (10 USDC at 5 bps; 11 USDC passes).
    function test_constructorRefusesBadFees() public {
        require(!tryDeploy(TronSourceVault.Fees(TREASURY, 31, 0, 0), MIN_DEPOSIT), "31 bps");
        require(!tryDeploy(TronSourceVault.Fees(TREASURY, 0, 31, 0), MIN_DEPOSIT), "31 bps release");
        require(!tryDeploy(TronSourceVault.Fees(address(0), 5, 0, 0), MIN_DEPOSIT), "no recipient");
        require(!tryDeploy(TronSourceVault.Fees(TREASURY, 0, 0, 0), MIN_DEPOSIT), "recipient without fee");
        require(!tryDeploy(TronSourceVault.Fees(address(usdc), 5, 5, 0), MIN_DEPOSIT), "token as recipient");
        require(!tryDeploy(TronSourceVault.Fees(TREASURY, 5, 5, 0), MIN_BURN), "minDeposit 10 nets below minBurn");
        require(tryDeploy(TronSourceVault.Fees(TREASURY, 30, 30, 0), MIN_DEPOSIT), "30 bps and 11 USDC pass");
        require(tryDeploy(TronSourceVault.Fees(TREASURY, 0, 5, 0), MIN_BURN), "release-only fee keeps minDeposit 10");
    }

    function tryDeploy(TronSourceVault.Fees memory fees, uint64 minDeposit) internal returns (bool ok) {
        (ok,) = address(this).call(abi.encodeCall(this.deployExternal, (fees, minDeposit)));
    }

    function deployExternal(TronSourceVault.Fees memory fees, uint64 minDeposit) external {
        new TronSourceVault(
            keccak256("ethereum"), keccak256("bloch-l2"), keccak256("USDC"), address(usdc), CAP, 1, addrs(ethKeys), 5,
            TronSourceVault.Policy(BUCKET, 1 days, 6, 14 days, minDeposit, MIN_BURN),
            TronSourceVault.Guard(new address[](0), 0, 0), TronSourceVault.Provenance(1, 0, address(0), fees)
        );
    }

    event log_named_uint(string key, uint256 val);

    /// Gas of a second deposit and of a release, with and without the fee, each with fresh users (logged with -vv).
    function test_gasWithAndWithoutFee() public {
        uint256[4] memory g;
        for (uint256 k; k < 2; ++k) {
            address a = address(uint160(0xA000 + k));
            address b = address(uint160(0xB000 + k));
            vault = k == 0
                ? deployVault(TronSourceVault.Fees(address(0), 0, 0, 0), MIN_BURN, 0)
                : deployVault(TronSourceVault.Fees(TREASURY, DEP_BPS, REL_BPS, 0), MIN_DEPOSIT, 0);
            token = deployToken(vault);
            usdc.mint(address(this), 2000 * U);
            vault.deposit(uint64(1000 * U), bytes32(uint256(uint160(a))));
            uint256 before = gasleft();
            vault.deposit(uint64(1000 * U), bytes32(uint256(uint160(b))));
            g[k * 2] = before - gasleft();
            uint64 net = uint64(1000 * U) - (k == 0 ? 0 : fee(uint64(1000 * U), DEP_BPS));
            mintAndCredit(vault.depositId(0, address(this), net, bytes32(uint256(uint160(a)))), 0, net, a);
            TronSourceVault.Release memory r = burn(a, net);
            vm.roll(block.number + 1);
            vm.setBlockhash(block.number - 1, keccak256(abi.encode(block.number)));
            TronSourceVault.ReleaseContext memory c = TronSourceVault.ReleaseContext(
                block.timestamp + 100, block.number - 1, keccak256(abi.encode(block.number)), 7, keccak256("l2")
            );
            bytes[] memory sigs = cert(vault.releaseDigest(r, c), 5);
            before = gasleft();
            vault.release(r, c, sigs);
            g[k * 2 + 1] = before - gasleft();
        }
        emit log_named_uint("deposit, no fee", g[0]);
        emit log_named_uint("deposit, 5 bps", g[2]);
        emit log_named_uint("release, no fee", g[1]);
        emit log_named_uint("release, 5 bps", g[3]);
        require(g[2] < g[0] + 30_000 && g[3] < g[1] + 30_000, "the fee adds less than 30k gas");
    }

    /// Every accepted deposit nets at least the L2 minimum burn, and fee + net == gross, for any accepted amount.
    function testFuzz_feeArithmetic(uint64 gross) public view {
        if (gross < MIN_DEPOSIT) gross = MIN_DEPOSIT + gross % 1000;
        if (gross > BUCKET) gross = uint64(MIN_DEPOSIT + gross % (BUCKET - MIN_DEPOSIT));
        uint64 f = fee(gross, DEP_BPS);
        require(f + (gross - f) == gross && gross - f >= MIN_BURN, "net >= minBurn");
        require(uint256(f) * 10_000 <= uint256(gross) * 30, "never above 0.30%");
    }
}
