{
  "_about": "Operator bundles (agent 381, round 18): one installable bundle per (route, role). ops/bundle.py builds a bundle from the route's committed tools and config templates at a git revision; ops/bridgectl.py installs, checks, starts, upgrades, rolls back and health-checks it on the host. Placeholders: {inst} = <route>-<role>, {release} = /opt/bloch-bridge/{inst}/current, {etc} = /etc/bloch-bridge/{inst}, {state} = /var/lib/bloch-bridge/{inst}, {run} = /run/bloch-bridge-{inst} (staged secrets, tmpfs, removed when the unit stops), {cast} = /opt/foundry/bin/cast, {py} = /usr/bin/python3 -E -s. docs/OPERATOR-PACKAGES.md explains every field.",
  "format": 1,
  "facts": {
    "_about": "Fixed public facts: the only literal values (besides TBD-owner, layout paths and decided parameters) a rendered config may hold. Each one names its source.",
    "values": {
      "0x632e45ae778da371a88dc1ae430193aa77eabb67a11de18e84fea7d20d11f468": "L2 mainnet genesis hash (BRIEF.md; deployments/mainnet/busdc-ops/guardiao.template.json)",
      "https://l2rpc.blochl1.com": "public L2 send gateway, decided for l2_tx_rpc (docs/BUSDC-MAINNET-V2.md:348)",
      "http://80.240.16.185:8080": "public Bloch L1 RPC (BRIEF.md)",
      "http://199.247.22.8:8080": "public Bloch L1 RPC (BRIEF.md)",
      "mainnet-v2": "L2 finality pins of the launch build (tools/signatario-stable/l2_finality.py)",
      "rebuild": "l2_source decided for mainnet signers (docs/BRIDGE-V3-OPERATOR-RUNBOOK.md section 3)",
      "stable": "guardian kind of the stablecoin bridges (tools/guardiao/guardiao.py)",
      "soft": "release_before_final decided value (deployments/mainnet/busdc-ops/guardiao.template.json)",
      "busdc-mainnet": "bridge name of the Ethereum bUSDC route in the guardian and reserves configs",
      "python3": "interpreter argv[0] in eth_half_* commands (the unit runs with ProtectSystem=strict; /usr/bin/python3 is the only python3 on PATH)",
      "--config": "argv token",
      "deposit": "argv token",
      "--deposit-id": "argv token",
      "{deposit_id}": "argv placeholder filled by signatario.py",
      "release": "argv token",
      "--intent": "argv token",
      "{intent}": "argv placeholder filled by signatario.py",
      "busdc-arbitrum-one": "bridge name of the Arbitrum One route in the guardian and reserves configs (agent 381; route owner to confirm)",
      "busdc-op-mainnet": "bridge name of the OP Mainnet route in the guardian and reserves configs (agent 381; route owner to confirm)",
      "busdc-linea": "bridge name of the Linea route in the guardian and reserves configs (agent 381; route owner to confirm)",
      "probe": "anchor_policy of the EVM networks, decided per chain id in tools/evm-nets/networks.json (agent 337/372); vigia.py refuses a file that contradicts it"
    }
  },
  "hardening": {
    "_about": "Applied to every daemon and timer unit. A role may only ADD lines (role.units[].extra); the builder refuses a unit spec that names one of these keys. Reasons: docs/OPERATOR-PACKAGES.md section 4.",
